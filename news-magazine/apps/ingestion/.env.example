# ============================================================
# apps/ingestion/.env — the Python worker's configuration
# Copy to .env and fill in. Gitignored; never commit.
# ============================================================

# --- Supabase (required) -----------------------------------
# Service-role key bypasses RLS. Server-side only — never send it
# to a browser. Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shared secrets (required) -----------------------------
# Must match INGESTION_SECRET in apps/web/.env.local so the
# Next.js admin trigger can call /api/sync.
INGESTION_SECRET=
CRON_SECRET=

# --- Scheduler ---------------------------------------------
# Only used when running the FastAPI app. worker.py always
# starts its own scheduler regardless of this value, because the
# standalone daemon is the intended production entrypoint.
SCHEDULER_ENABLED=true

# --- Retention ---------------------------------------------
# Articles are deleted this many hours after publication. A
# pruned story comes back if someone searches for it — see
# /api/scrape-on-demand.
RETENTION_HOURS=48

# Hard ceiling on the articles table, applied after the TTL pass.
MAX_ARTICLE_ROWS=10000

# --- Dedup -------------------------------------------------
# Syndicated copies within this window collapse into one story.
DEDUP_WINDOW_HOURS=12

# rapidfuzz title-similarity score (0-100) at or above which two
# headlines are considered the same story. 78 is tuned for long
# Nepali headlines with outlet suffixes; raise it to be stricter.
FUZZY_TITLE_THRESHOLD=82

# --- Fetching ----------------------------------------------
# Minimum seconds between polls of the SAME source. Also the
# floor applied to any poll_interval_seconds in the sources table.
#
# 60 is the floor for politeness, not for freshness. Each source still
# polls on its own interval (the fastest are 180s). Lowering this only
# affects sources whose poll_interval_seconds is already below the
# floor. Going sub-minute across all 25 sources would put ~50 requests
# a minute into news publishers and get the IP blocked, so it is not
# worth doing.
MIN_POLL_SECONDS=60

# Identifies us to every outlet we fetch. Put a real contact URL
# and email here — several outlets block generic bot strings.
DEFAULT_USER_AGENT=NepalNewsMagazineBot/1.0 (+https://new24hr.vercel.app; contact=admin@new24hr.vercel.app)
DEFAULT_REQUEST_TIMEOUT_SECONDS=15

# --- On-demand search --------------------------------------
# Hard ceiling on live scraping per search, and how many times one
# query may be scraped per hour before it is refused.
MAX_REQUESTS_PER_HOUR=5
SCRAPE_BUDGET_SECONDS=18

# --- Gemini (optional) -------------------------------------
# The 4-point summaries are NOT generated by Gemini. They are
# extracted verbatim from each outlet's own article text by
# services/summarizer.py. No key is required for them.
#
# ENABLE_GEMINI_RANKING=true -> Gemini is given the four extracted
#   points and returns the ORDER to show them in. It cannot write
#   text: the prompt asks only for an array of indices, the model
#   runs at temperature 0.0, and every returned index is resolved
#   against the original list — anything not already present is
#   discarded and the extractive order is restored. A timeout,
#   a malformed response or a missing key all return the original
#   order unchanged.
#
# ENABLE_GEMINI_SUMMARY is DEFINED BUT NOT WIRED UP.
#   synthesize_summary() in services/ingestion.py has no caller, so
#   setting this to true currently does nothing. It is left in place
#   rather than removed so the behaviour can be turned on properly if
#   a model-written excerpt is ever wanted — the function writes only
#   `excerpt`, never the headline and never the points.
#
# The feature that DOES use the key on the web side is
# /api/ai-search, which briefs only the articles a search actually
# returned and falls back to raw results when the key is absent. That
# one needs GEMINI_API_KEY set on VERCEL, not just on Render.
GEMINI_API_KEY=
ENABLE_GEMINI_SUMMARY=false
ENABLE_GEMINI_RANKING=true

# --- Logging -----------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console   # console | json