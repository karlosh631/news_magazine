# ============================================================
# apps/ingestion/.env — the Python worker's configuration
# Copy to .env and fill in. Gitignored; never commit.
# ============================================================

# --- Supabase (required) -----------------------------------
# Service-role key bypasses RLS. Server-side only — never send it
# to a browser. Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Shared secrets (required) -----------------------------
# Must match INGESTION_SECRET in apps/web/.env.local so the
# Next.js admin trigger can call /api/sync.
INGESTION_SECRET=
CRON_SECRET=

# --- Scheduler ---------------------------------------------
# Only used when running the FastAPI app. worker.py always
# starts its own scheduler regardless of this value, because the
# standalone daemon is the intended production entrypoint.
SCHEDULER_ENABLED=true

# --- Retention ---------------------------------------------
# Articles are deleted this many hours after publication. A
# pruned story comes back if someone searches for it — see
# /api/scrape-on-demand.
RETENTION_HOURS=48

# Hard ceiling on the articles table, applied after the TTL pass.
MAX_ARTICLE_ROWS=10000

# --- Dedup -------------------------------------------------
# Syndicated copies within this window collapse into one story.
DEDUP_WINDOW_HOURS=12

# rapidfuzz title-similarity score (0-100) at or above which two
# headlines are considered the same story. 78 is tuned for long
# Nepali headlines with outlet suffixes; raise it to be stricter.
FUZZY_TITLE_THRESHOLD=82

# --- Fetching ----------------------------------------------
# Minimum seconds between polls of the SAME source. Also the
# floor applied to any poll_interval_seconds in the sources table.
#
# 60 is the floor for politeness, not for freshness. Each source still
# polls on its own interval (the fastest are 180s). Lowering this only
# affects sources whose poll_interval_seconds is already below the
# floor. Going sub-minute across all 25 sources would put ~50 requests
# a minute into news publishers and get the IP blocked, so it is not
# worth doing.
MIN_POLL_SECONDS=60

# Identifies us to every outlet we fetch. Put a real contact URL
# and email here — several outlets block generic bot strings.
DEFAULT_USER_AGENT=NepalNewsMagazineBot/1.0 (+https://new24hr.vercel.app; contact=admin@new24hr.vercel.app)
DEFAULT_REQUEST_TIMEOUT_SECONDS=15

# --- Image validation --------------------------------------
# Image URLs used to be chosen by ranking the URL's shape and stored
# unverified. Some of those URLs are permanently dead — an
# assets-cdn.kathmandupost.com request is refused outright with a 403
# — so the feed carried dead links and only a reader's browser ever
# found out. Turning this on asks each URL to prove it returns an
# image before the row is written, so the guarantee is made once,
# server-side, for every reader on every page.
#
# Cost: one ranged GET per NEW image, deduplicated by URL within a
# source poll, so outlets reusing one image across stories pay once.
# Set to false to store URLs unverified again.
VALIDATE_IMAGES=true
# Per-probe ceiling. A 403 or 404 answers in milliseconds; only a CDN
# that hangs reaches this.
IMAGE_VALIDATION_TIMEOUT_SECONDS=6
# How many renditions of one article may be probed before it is stored
# bare. Almost every article has one candidate or two; this only
# bounds the pathological page.
MAX_IMAGE_CANDIDATES_PER_ARTICLE=3

# --- Full article body (opt-in, licence-gated) -----------
# The article page's "read more" used to expand the EXCERPT and stop,
# because sources.republish_permission (migration 0001, "full-text
# republish allowed?") guarded a field nothing ever populated. Both
# adapters set full_body_html=None at normalize() time — which is
# before any page has been fetched — so flipping the flag in the
# database changed nothing.
#
# Only PLAIN TEXT is stored, never the publisher's markup: full-text
# republication is a licensing decision, carrying untrusted HTML to a
# reader is a security one, and the two are separable. Bodies are
# bounded to 20,000 characters — the same cap the renderer applies.
#
# BOTH FLAGS DO NOTHING WITHOUT republish_permission ON THE SOURCE ROW.
# The licence is checked before any request is made, and again before
# the text is stored, so a source with the flag false never fetches a
# page for its body and never keeps one. Set it per outlet, in the
# database, only where that publisher actually licenses it.
#
# NOTE: it is seeded FALSE for every outlet (migration 0001 defaults
# the column false; 0008 seeds it false). Out of the box, therefore,
# no article has a body whatever these flags say — articles carry a
# summary and an attribution link to the outlet. Flipping ENRICH_BODY
# is necessary but not sufficient; the licence column is the real
# gate. GET /api/sources reports `body_status` per outlet.
#
# ENRICH_BODY is FREE. It reuses the page media enrichment already
# fetches for og:image / video / audio and takes the plain text
# trafilatura already pulled off it. Zero extra requests, so it is on
# by default: leaving it off meant the producer returned before doing
# anything, and an outlet WITH a granted licence still got an
# excerpt-only article.
#   false -> full_body_html stays None everywhere, exactly as before
ENRICH_BODY=true
#
# FETCH_FULL_TEXT COSTS A REQUEST. It covers the stories whose page
# media enrichment had no reason to open (the feed already carried an
# image), by paying one page fetch per article for them. Across 27
# publishers that is one request per story per poll — a crawl rather
# than a poll, and how an operator's IP gets blocked. Hence a separate
# flag: turning body storage on should not acquire a crawl by accident.
# robots.txt and the per-source rate limiter are honoured first.
FETCH_FULL_TEXT=false

# --- Fetch caps ---------------------------------------------
# How much ONE cycle is allowed to pull in.
#
# Every one of these is a HARD bound on the number of items actually
# fetched and stored, enforced at the point the work is done — not a
# target, and not a number nothing reads. Raise one and the pipeline
# really does fetch more; lower one and it really does fetch less.
#
# WHY THEY EXIST: a feed is a PAGE, not a stream. An outlet that
# published 400 stories today serves all 400 in one feed document, and
# every one of them would otherwise be normalised, deduped, page-fetched
# for its media and stored on the very first poll. The same is true one
# level up: 27 outlets polled on their own intervals put a few thousand
# entries through the pipeline in a quarter of an hour, and each entry
# costs a dedup lookup whether or not it turns out to be a story you
# already have.
#
# A cap that truncates a poll is logged as a warning and written to
# source_errors with error_type=fetch_capped, so the admin dashboard
# shows it. It is not a failure: the run stays a success and the
# articles that were in range are stored normally.
#
# Per outlet, per poll. 200 is comfortably above what any single
# Nepali outlet publishes between two polls, so this does not bite in
# normal operation — and it is a real bound when it does.
MAX_ARTICLES_PER_SOURCE=200
#
# Across EVERY outlet, in one cycle. The per-outlet cap alone still
# allows 27 x 200, which is a crawl of 27 publishers rather than a poll
# of them. This is the number that bounds the pipeline's total
# appetite, and it is what a runaway source can no longer spend on its
# own.
MAX_ARTICLES_PER_CYCLE=20000
#
# How long ONE cycle is, in seconds. The scheduler has no single pass
# over every outlet — each source has its own interval and they are
# staggered — so "one cycle" is a WINDOW rather than a batch. The total
# cap applies within the window, and the window restarts as soon as the
# previous one expires: a rate, not a one-shot allowance.
CYCLE_WINDOW_SECONDS=900

# --- On-demand search --------------------------------------
# Hard ceiling on live scraping per search, and how many times one
# query may be scraped per hour before it is refused.
MAX_REQUESTS_PER_HOUR=5
SCRAPE_BUDGET_SECONDS=18

# --- Gemini (optional) -------------------------------------
# The 4-point summaries are NOT generated by Gemini. They are
# extracted verbatim from each outlet's own article text by
# services/summarizer.py. No key is required for them.
#
# ENABLE_GEMINI_RANKING=true -> Gemini is given the four extracted
#   points and returns the ORDER to show them in. It cannot write
#   text: the prompt asks only for an array of indices, the model
#   runs at temperature 0.0, and every returned index is resolved
#   against the original list — anything not already present is
#   discarded and the extractive order is restored. A timeout,
#   a malformed response or a missing key all return the original
#   order unchanged.
#
# ENABLE_GEMINI_SUMMARY is DEFINED BUT NOT WIRED UP.
#   synthesize_summary() in services/ingestion.py has no caller, so
#   setting this to true currently does nothing. It is left in place
#   rather than removed so the behaviour can be turned on properly if
#   a model-written excerpt is ever wanted — the function writes only
#   `excerpt`, never the headline and never the points.
#
# The feature that DOES use the key on the web side is
# /api/ai-search, which briefs only the articles a search actually
# returned and falls back to raw results when the key is absent. That
# one needs GEMINI_API_KEY set on VERCEL, not just on Render.
GEMINI_API_KEY=
ENABLE_GEMINI_SUMMARY=false
ENABLE_GEMINI_RANKING=true

# --- Reels (optional) -------------------------------------
# Short-form video for /category/reels. Only METADATA is stored;
# playback streams from the provider's CDN. The page itself needs
# nothing on the web side — migration 0014 already put the `reels`
# category in the nav.
#
# ENABLE_REELS IS THE ONLY REQUIRED VARIABLE, and it is the whole
# reason the page can sit empty: the reels job is only registered when
# this is true, and it defaults to false. Nothing polls until you flip
# it. No redeploy is needed afterwards — the scheduler re-reads the
# setting on its 5-minute registry refresh, so turning it on or off
# takes effect on its own (off removes the job rather than just
# declining to add it).
ENABLE_REELS=true

# Clips fetched per provider, per pass. Each provider is asked for at
# most this many, and the store is handed at most this many — the cap
# is applied to the REQUEST, not to the rows after the fact.
# Wikimedia over-fetches internally and filters.
#
# This was REELS_PER_SOURCE; the old name still works, and a
# deployment that still sets it keeps its value.
MAX_REELS_PER_PROVIDER=100

# Clips fetched by the WHOLE pass, across every provider. One reels
# pass is one cycle on the video side: the job runs every provider
# once, in order. What is left of the budget is shared fairly between
# the providers still to run, so a tight budget thins every provider's
# share instead of starving the last one to be asked.
MAX_REELS_PER_CYCLE=500

# Seconds between reels passes. The floor is MIN_POLL_SECONDS (60).
# Five minutes: frequent enough that the tab reads as live, and polite
# enough for one shared provider API. Not matched to the article
# cadence on purpose — Commons is a single API with an explicit
# politeness policy, not 27 independent sites.
REELS_POLL_SECONDS=300

# Per-request timeout for provider APIs, in seconds.
REELS_HTTP_TIMEOUT=20

# Hard ceiling on ONE WHOLE reels pass. The job runs at
# max_instances=1, so a pass that never returns never runs again and
# the category goes silent with no error anywhere. This bounds it.
REELS_PASS_TIMEOUT_SECONDS=180

# Identifies us to Wikimedia Commons, whose API policy asks every
# client to identify itself and says anonymous traffic is what gets
# access withdrawn. Put a real contact address here, not a bare
# product token.
REELS_USER_AGENT=NepalNewsMagazineReels/1.0 (+https://new24hr.vercel.app)

# --- Reels: provider API keys (all optional) ---------------
# WIKIMEDIA NEEDS NO KEY AT ALL and is always polled. Setting
# ENABLE_REELS=true is therefore sufficient on its own: the category
# fills with Creative Commons clips from Commons with zero
# credentials configured. The keys below add coverage; a provider
# with no key is logged as SKIPPED and never affects the others.
#
# Comma-separated — the pool rotates across them and skips any that
# are rate limited, so one exhausted key does not take the page down.
PEXELS_API_KEYS=
PIXABAY_API_KEYS=

# YOUTUBE_DATA_API_KEYS adds Shorts to the feed, but READ THIS FIRST —
# it is not like the two above.
#
# 1. IT IS AN EMBEDDING SOURCE, NOT A REDISTRIBUTABLE ONE. Pexels and
#    Pixabay grant us the right to republish their clips. YouTube does
#    not grant that to anyone: the Standard Licence belongs to the
#    uploader. What this key buys is the ability to embed a Short in
#    YouTube's own player, credited to its channel. Nothing is
#    downloaded, re-hosted or claimed as ours.
#
# 2. THE MEDIA FILE IS NOT AVAILABLE, BY CHOICE. The real bytes sit
#    behind a signature derived from YouTube's player. Decoding one is
#    scraping, so the adapter never does it; every card is an <iframe>.
#    It needs migration 0015_reels_embed_url.sql applied.
#
# 3. THE QUOTA IS ROUGHLY 100x TIGHTER THAN THE OTHERS, AND THE
#    ADAPTER POLLS ITSELF DOWN TO MATCH. search.list costs 100 units
#    per call against a default daily budget of 10,000 — about 95
#    searches. At REELS_POLL_SECONDS=300 the job wakes 288 times a
#    day, which would spend one key in half an hour.
#    YouTubeShortsSource therefore declares min_poll_seconds = 3600
#    and the scheduler honours it, so a pass every five minutes calls
#    it roughly once an hour and skips it the other eleven times
#    (logged as SKIPPED, not an error — that is the system working).
#    You do NOT need to raise REELS_POLL_SECONDS to use this key, and
#    you should not: doing that would also slow the providers that
#    cost nothing. Adding a second key halves the interval again.
#
# Only an API key goes here. No OAuth client, no refresh token and no
# `player` scope — that part of the API is OAuth-only and is not called.
YOUTUBE_API_KEYS=

# Comma-separated search hints ("nepal, kathmandu"). Only the first
# is currently used — the adapters take one hint and spread the query
# themselves — so this is a single value in practice. Wikimedia turns
# it into a CirrusSearch term; Pexels and Pixabay filter on it.
REELS_SEARCH_TERMS=nepal,kathmandu

# --- Panchang (the Nepali almanac) ---------------------------
#
# The Bikram Sambat date, the tithi, the nakshatra, sunrise and
# sunset, and the windows the panchang calls auspicious and
# inauspicious — the line in the site header that says what day it
# is.
#
# This is its own pipeline with its own table. It is NOT an article:
# it is never normalised, never validated and never deduplicated
# against the outlets, and it cannot affect an outlet poll.
#
# It needs migration 0022_daily_panchang.sql applied. Until it is,
# the job logs that the table is missing and the header shows no
# almanac — which is the correct state for an unlaunched feature, not
# a broken site.
#
# The job runs hourly because the Bikram Sambat date rolls over at
# midnight NEPALI time. It is cheap despite the cadence: one pass
# resolves today's date from a small page and downloads the large
# per-day page only when the day has actually changed.
ENABLE_PANCHANG=true
PANCHANG_POLL_SECONDS=3600
PANCHANG_HTTP_TIMEOUT_SECONDS=20.0

# --- Logging -----------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console   # console | json